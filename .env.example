SALU_DB_HOST=127.0.0.1
SALU_DB_PORT=3307
SALU_DB_USER=salu_app
SALU_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
SALU_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
SALU_SERVER_HOST=127.0.0.1
SALU_SERVER_PORT=8081
SALU_FRONTEND_PORT=5174
SALU_COOKIE_SECURE=false
SALU_PHOTO_ROOT=CHANGE_ME_PHOTO_ROOT

# python3 scripts/init-backup-key.py로 개발 키 생성. 공개 배포 시 별도 보관한 키 파일 사용.
# SALU_BACKUP_KEY_FILE=/absolute/private/salu-backup-keys.json
SALU_BACKUP_KEY_ID=v1
SALU_PUBLIC_ORIGIN=http://127.0.0.1:5174
# 각 제공자에 위 origin + /api/auth/oauth2/callback/google 또는 /naver 등록
SALU_GOOGLE_CLIENT_ID=
SALU_GOOGLE_CLIENT_SECRET=
SALU_NAVER_CLIENT_ID=
SALU_NAVER_CLIENT_SECRET=

# 커뮤니티 검색용 Elasticsearch(docs/community-api.md `검색 서버`). 비우면 DB 검색만 씀. 로컬: docker compose --profile search up -d 뒤 http://127.0.0.1:9200
SALU_SEARCH_URL=

# AI 도우미(docs/ai-api.md). 비우면 꺼짐. Ollama: http://<모델 PC>:11434, OpenAI: https://api.openai.com
SALU_AI_BASE_URL=
SALU_AI_MODEL=qwen3:8b
SALU_AI_API_KEY=
# Ollama는 none, OpenAI gpt-5 계열은 minimal
SALU_AI_REASONING_EFFORT=none
# 같은 질문에 답이 흔들리지 않게 고정. 값을 받지 않는 모델이면 비움
SALU_AI_TEMPERATURE=0

# 비밀번호 찾기 메일(docs/login.md). 비우면 꺼짐. 로컬 Mailpit은 127.0.0.1·1025·AUTH/STARTTLS false
SALU_MAIL_HOST=
SALU_MAIL_PORT=587
SALU_MAIL_USERNAME=
SALU_MAIL_PASSWORD=
SALU_MAIL_FROM=
SALU_MAIL_AUTH=true
SALU_MAIL_STARTTLS=true

# 상담 요금 결제(docs/payment-api.md). 비우면 꺼짐. 토스페이먼츠 테스트 키(test_ck_·test_sk_). 시크릿 키는 서버에만
SALU_TOSS_CLIENT_KEY=
SALU_TOSS_SECRET_KEY=
