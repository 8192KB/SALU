    "format:check": "prettier --check src tests scripts *.ts *.json",
    "capture": "node scripts/capture-prototype.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
