{
  "name": "salu-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write src scripts *.ts *.json",
    "format:check": "prettier --check src scripts *.ts *.json",
    "dev:prototype": "vite --mode prototype",
    "schema:backup": "node scripts/generate-backup-schema.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
